// Prisma schema for optional lead/inquiry storage
// Switch provider to "postgresql" for production if preferred.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  subject   String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}